# 이 파일을 .env 로 복사해서 쓴다. .env 는 저장소에 올라가지 않는다.
#
#   cp .env.example .env
#
# 아무것도 설정하지 않으면 로컬 claude CLI 를 쓴다(키 불필요).
# 아래 세 줄의 주석을 풀면 OpenAI 호환 엔드포인트로 보낸다.
# 셸에서 export 한 값이 이 파일보다 우선한다.

# --- Gemini (무료 티어 가능, OpenAI 호환 경로) --------------------------------
# YT_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# YT_LLM_API_KEY=여기에_발급받은_키
# YT_LLM_MODEL=gemini-2.5-flash

# --- OpenAI -----------------------------------------------------------------
# YT_LLM_BASE_URL=https://api.openai.com/v1
# YT_LLM_API_KEY=sk-...
# YT_LLM_MODEL=gpt-5

# --- Ollama (로컬, 키 없음) ----------------------------------------------------
# YT_LLM_BASE_URL=http://localhost:11434/v1
# YT_LLM_MODEL=qwen3:8b
